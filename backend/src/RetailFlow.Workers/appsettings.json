{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=RetailFlow;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "CommandTimeoutSeconds": 60
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 60,
    "MaxAttempts": 10,
    "BaseBackoffSeconds": 5,
    "MaxBackoffSeconds": 900
  },
  "Jobs": {
    "PaymentStatusQueryIntervalSeconds": 60,
    "LowStockAlertCron": "0 6 * * *",
    "ExpiryAlertCron": "0 6 * * *",
    "LoyaltyExpiryCron": "0 2 1 * *",
    "LedgerReconciliationCron": "0 3 * * *",
    "RetentionPurgeCron": "0 4 * * 0"
  },
  "PaymentProviders": {
    "Bkash": {
      "Enabled": false,
      "Mode": "Sandbox",
      "BaseUrl": "https://tokenized.sandbox.bka.sh",
      "AppKey": "",
      "AppSecret": "",
      "Username": "",
      "Password": "",
      "CallbackSigningSecret": "",
      "OfflineSupported": false,
      "TimeoutSeconds": 30
    },
    "Nagad": {
      "Enabled": false,
      "Mode": "Sandbox",
      "BaseUrl": "https://sandbox.mynagad.com",
      "MerchantId": "",
      "MerchantPrivateKey": "",
      "NagadPublicKey": "",
      "CallbackSigningSecret": "",
      "OfflineSupported": false,
      "TimeoutSeconds": 30
    }
  },
  "Messaging": {
    "Provider": "InProcess"
  }
}
