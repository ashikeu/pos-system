{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=RetailFlow;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "retailflow-clients",
    "Algorithm": "HS256",
    "SigningKey": "dev-only-signing-key-change-before-any-shared-environment-32b+",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "ClockSkewSeconds": 30
  },
  "Security": {
    "PasswordIterations": 210000,
    "MinimumPasswordLength": 8,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetTokenMinutes": 30,
    "EmailVerificationTokenHours": 48,
    "RequireMfaForRoles": [],
    "SecretProtectionKey": "cmV0YWlsZmxvdy1kZXYtc2VjcmV0LXByb3RlY3QzMiE="
  },
  "Tenancy": {
    "DefaultPlanCode": "STARTER",
    "DefaultPeriodDays": 30,
    "GraceDays": 7,
    "DefaultBranchCode": "MAIN",
    "DefaultWarehouseCode": "MAIN",
    "DefaultTerminalCode": "POS1",
    "StatusCacheSeconds": 30,
    "SettingsCacheSeconds": 300,
    "Defaults": {
      "PriceIncludesTax": true,
      "AllowNegativeStock": false,
      "RequireOpenShiftToSell": true,
      "CashRoundingIncrement": 1.0,
      "CashRoundingMode": "Nearest",
      "MaxLineDiscountPercent": 10,
      "VoidWindowMinutes": 60,
      "ReturnWindowDays": 7,
      "OfflineMaxDurationHours": 72,
      "OfflineMaxSaleAmount": 50000,
      "OfflineMaxCumulativeAmount": 200000,
      "LoyaltyEnabled": false,
      "CreditSalesEnabled": false,
      "InvoiceNumberFormat": "{BRANCH}-{YYYY}{MM}-{SEQ}",
      "ReceiptTemplate58": "default-58",
      "ReceiptTemplate80": "default-80",
      "ReceiptFooterText": ""
    }
  },
  "PaymentProviders": {
    "Bkash": {
      "Enabled": false,
      "Mode": "Sandbox",
      "BaseUrl": "https://tokenized.sandbox.bka.sh",
      "AppKey": "",
      "AppSecret": "",
      "Username": "",
      "Password": "",
      "CallbackSigningSecret": "",
      "OfflineSupported": false,
      "TimeoutSeconds": 30
    },
    "Nagad": {
      "Enabled": false,
      "Mode": "Sandbox",
      "BaseUrl": "https://sandbox.mynagad.com",
      "MerchantId": "",
      "MerchantPrivateKey": "",
      "NagadPublicKey": "",
      "CallbackSigningSecret": "",
      "OfflineSupported": false,
      "TimeoutSeconds": 30
    }
  },
  "Messaging": {
    "Provider": "InProcess",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/"
    }
  },
  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "Configuration": "localhost:6379",
      "Password": "",
      "InstanceName": "retailflow:"
    }
  },
  "Email": {
    "Provider": "None",
    "Smtp": {
      "Host": "localhost",
      "Port": 25,
      "UserName": "",
      "Password": "",
      "UseStartTls": true,
      "FromAddress": "no-reply@retailflow.local",
      "FromName": "RetailFlow POS"
    }
  },
  "Api": {
    "CorrelationIdHeader": "X-Correlation-Id",
    "BranchHeader": "X-Branch-Id",
    "IdempotencyKeyHeader": "Idempotency-Key",
    "IdempotencyRetentionDays": 90,
    "RateLimit": {
      "AuthRequestsPerMinute": 10,
      "GeneralRequestsPerMinute": 300
    }
  },
  "AllowedHosts": "*"
}
